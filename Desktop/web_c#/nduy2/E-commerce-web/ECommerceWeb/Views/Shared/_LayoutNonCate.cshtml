@using ECommerceWeb.ViewModels

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"]</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <link href="/css/layout.css" rel="stylesheet" />
</head>
<body class="bg-light">

    <!-- Navbar -->
    <nav class="navbar navbar-expand-lg navbar-dark bg-primary">
        <div class="container">
            <!-- Logo -->
            <a class="navbar-brand" href="/Home/Index">
                <img src="/LogoImage/logo.png" alt="Logo" height="50">
            </a>

            <!-- Search -->
            <form class="d-flex w-50 mx-3" asp-action="Search" asp-controller="Home">
                <div class="position-relative flex-grow-1 me-2">
                    <input class="form-control" id="searchBox" type="search"
                           placeholder="Bạn muốn tìm gì hôm nay?" name="query" autocomplete="off">

                    <div class="instant-results bg-white rounded shadow" id="suggestions" style="display:none; position:absolute; top:100%; left:0; right:0; z-index:1000; max-height:400px; overflow-y:auto;">
                        <!-- Suggestions sẽ được inject bằng JS -->
                    </div>
                </div>
                <button class="btn btn-warning" type="submit">Tìm</button>
            </form>

            <!-- Nav items -->
            <div class="navbar-nav ms-auto">
                <ul class="navbar-nav d-flex flex-row align-items-center gap-3">
                    @if (Context.Session.GetInt32("UserId").HasValue)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link text-white dropdown-toggle d-flex align-items-center"
                               href="#" id="userDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                <img src="/LogoImage/acc.png" height="20" class="me-2" />
                                @Context.Session.GetString("Username")
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="userDropdown">
                                <li><a class="dropdown-item" asp-controller="Account" asp-action="Profile">Thông tin tài khoản</a></li>
                                <li><a class="dropdown-item" asp-controller="Order" asp-action="Orders">Đơn hàng của tôi</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" asp-controller="Account" asp-action="Logout">Đăng xuất</a></li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link text-white d-flex align-items-center"
                               asp-controller="Account" asp-action="Login">
                                <img src="/LogoImage/acc.png" height="20" class="me-2" />
                                Đăng nhập
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link text-white"
                               asp-controller="Account" asp-action="Register">
                                Đăng ký
                            </a>
                        </li>
                    }

                    <li class="nav-item">
                        <a class="nav-link text-white d-flex align-items-center"
                           asp-controller="Cart" asp-action="Index">
                            <img src="/LogoImage/cart.png" height="20" class="me-2" />
                            Giỏ hàng
                        </a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>




    <!-- Nội dung chính -->
    <main>
        @RenderBody()
    </main>


    <!-- Footer -->
    <footer class="bg-primary text-white text-center py-3 mt-5">
        © 2025 Điện Máy Xanh Clone - ECommerceWeb
    </footer>

    <script src="/js/suggestions.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>