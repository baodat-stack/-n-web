@using ECommerceWeb.Models.Entity
@model List<ECommerceWeb.ViewModels.AdminProductDetailVM>
@{
    ViewBag.Title = "Product Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="row">
    <div class="col-12">
        <div class="border-bottom pb-3 mb-4">
            <h2 class="h4 fw-semibold mb-0">Quản lý sản phẩm</h2>
        </div>
    </div>

    <div class="d-flex justify-content-between align-items-center mb-3">
        <a asp-action="AddProduct" class="btn btn-primary">
            Thêm sản phẩm
        </a>
        <input type="text" id="search" name="keyword" class="form-control me-2 d-flex" style="max-width: 300px;" placeholder="Tìm sản phẩm..."
                value="@ViewBag.Keyword" />
    </div>

    <div id="productTableContainer">
        @await Html.PartialAsync("_ProductTable", @Model)
    </div>
    
</div>

@section Scripts {
    <script>
        $("#search").keyup(function () {
            var search = $("#search").val();
            $.ajax({
                url: "/Admin/SearchProducts",
                data: { keyword: search },
                success: function (response) {
                    $("div#productTableContainer").html(response);
                }
            });
        });
    </script>
}