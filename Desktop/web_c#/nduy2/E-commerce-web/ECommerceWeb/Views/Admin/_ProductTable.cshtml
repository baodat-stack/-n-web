@model List<ECommerceWeb.ViewModels.AdminProductDetailVM>
@using ECommerceWeb.Models.Entity;
<table class="table table-hover align-middle mb-0">
        <thead class="table-light">
            <tr>
                <th class="py-3" style="width:50%">Tên sản phẩm</th>
                <th class="py-3" style="width:15%">Giá</th>
                <th class="py-3" style="width:10%">Danh mục</th>
                <th class="py-3" style="width:10%">Hình ảnh</th>
                <th class="py-3" style="width:10%">Trạng thái</th>
                <th class="py-3">Hành động</th>
            </tr>
        </thead>
        <tbody id="result">
            @foreach (var product in Model)
            {
                <tr>
                    <td class="py-3">@product.Name</td>
                    <td class="py-3 fw-semibold">@product.Price.ToString("C")</td>
                    <td class="py-3">
                        <span class="badge bg-light text-dark rounded-pill">@product.Category?.Name</span>
                    </td>
                    <td class="py-3">
                        <img src="@product.Images[0].Url" alt="@product.Name" width="60" height="60"
                            class="img-thumbnail" />
                    </td>
                    <td class="py-3">
                        @if (@product.Status == ProductStatus.IN_STOCK)
                        {

                            <span class="text-primary rounded-pill badge bg-light p-2">Còn hàng</span>
                        }
                        else if (@product.Status == ProductStatus.OUT_OF_STOCK)
                        {
                            <span class="text-danger rounded-pill badge bg-light p-2">Hết hàng</span>
                        }
                        else
                        {
                            <span class="text-secondary rounded-pill badge bg-light p-2">Ngừng kinh doanh</span>
                        }
                    </td>
                    <td class="py-3">
                        <div class="d-flex gap-2">
                            <a asp-action="EditProduct" asp-route-id="@product.Id" class="btn btn-sm btn-primary">Sửa</a>
                            <a asp-action="DeleteProduct" asp-route-id="@product.Id" class="btn btn-sm btn-danger">Xóa</a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
    <div class="row mt-4">
        <div class="col-12">
            <nav aria-label="Phân trang">
                <ul class="pagination justify-content-center mb-0">

                    @for (int i = 0; i < @ViewBag.TotalPages; i++)
                    {
                        <li class="page-item @(i == @ViewBag.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Product" asp-route-page="@i">
                                @(i + 1)
                            </a>
                        </li>
                    }

                </ul>
            </nav>
        </div>
    </div>
