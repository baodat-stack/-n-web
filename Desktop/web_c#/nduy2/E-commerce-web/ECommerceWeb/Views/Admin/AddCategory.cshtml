@{
    ViewBag.Title = "Add Category";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
<div class="container-fluid px-4 py-4">
    <div>
        <a asp-action="Category" asp-controller="Admin" class="btn btn-secondary mb-4 bg-primary">
            <i class="bi bi-arrow-left-circle me-2"></i> Quay lại
        </a>
    </div>
    <div class="row">
        <div class="col-12">
            <div class="border-bottom pb-3 mb-4">
                <h2 class="h4 fw-semibold mb-0">Thêm danh mục mới</h2>
            </div>
        </div>
    </div>

    <form asp-action="AddCategory" method="post">
        <div class="form-group mb-3">
            <label for="name" class="control-label">Tên danh mục</label>
            <input type="text" name="name" class="form-control" required />
        </div>
        <input type="submit" class="btn btn-primary" value="Thêm danh mục">
    </form>
</div>