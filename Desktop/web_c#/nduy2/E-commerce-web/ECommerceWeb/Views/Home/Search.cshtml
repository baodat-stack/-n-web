@using ECommerceWeb.Models.Entity
@model IEnumerable<ECommerceWeb.ViewModels.ProductVM>

@{
    ViewData["Title"] = "Search";
    Layout = "_LayoutNonCate";
}

<div class="container mt-4">
    <div class="card shadow-sm border-0">
        <!-- Tiêu đề -->
        <div class="card-header bg-primary text-white fw-bold d-flex align-items-center">
            <img src="/LogoImage/sale.png" width="30" height="30" class="me-2" />
            Kết quả
        </div>

        <!-- Danh sách sản phẩm -->
        <div class="card-body">
            <div class="row row-cols-2 row-cols-md-3 row-cols-lg-5 g-3">
                @await Html.PartialAsync("ProductItem", Model)
            </div>
        </div>
    </div>
</div>